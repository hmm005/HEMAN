{
  "name": "deal-dashboard",
  "version": "1.0.0",
  "description": "Deal alert system monitoring 15+ sources with SMS alerts and live dashboard",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "scan": "node src/scheduler.js --once",
    "dashboard": "node src/dashboard/server.js",
    "dev": "nodemon src/index.js",
    "import": "node src/outreach/csvImport.js",
    "campaign": "node src/outreach/campaign.js",
    "campaign:dry": "node src/outreach/campaign.js --dry-run"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "better-sqlite3": "^11.5.0",
    "cheerio": "^1.0.0-rc.12",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.5",
    "twilio": "^4.23.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
