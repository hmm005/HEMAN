# Twilio SMS Alerts
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_TO_NUMBER=+1xxxxxxxxxx

# eBay Developer API (free)
EBAY_APP_ID=YourApp-YourName-PRD-xxxxxxxxx-xxxxxxxx

# Scan Settings
SCAN_INTERVAL_MINUTES=30
MAX_ALERTS_PER_SCAN=5

# Dashboard
PORT=3000

# Property Owner Outreach (email-only, no SMS needed)
# Recommended: Zoho Mail free plan on your custom domain
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USER=heman@elevatehomesolutions.com
EMAIL_PASS=your-email-password
EMAIL_FROM=heman@elevatehomesolutions.com

# Set to 'true' to enable live sends (leave blank or 'false' for dry-run safety)
OUTREACH_ENABLED=false

# Date you started warming up this email address (YYYY-MM-DD).
# The system uses this to auto-calculate how many emails per day are safe to send.
WARMUP_START_DATE=2026-04-18
